# Netlify response headers for deptofbuilding.com

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# The font file never changes under this name, so browsers may keep it for a year.
# If the font is ever replaced, give the new file a new name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
